{
  "name": "@atomone/atomone-types",
  "version": "4.1.0",
  "description": "JS and TS types relating to Protocol Buffers used by AtomOne",
  "contributors": [
    "Simon Warta <webmaster128@users.noreply.github.com>",
    "Will Clark <willclarktech@users.noreply.github.com>",
    "Dan Lynch <pyramation@gmail.com>",
    "Alex M.<alex.megalokonomos@tendermint.com>"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/atomone-hub/atomone-types"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "./scripts/codegen.js && rm -rf ./dist && tsc",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "packageManager": "pnpm@12.4.2",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@cosmjs/amino": "^0.39.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@cosmjs/tendermint-rpc": "^0.39.0",
    "@cosmology/telescope": "^1.12.21",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
