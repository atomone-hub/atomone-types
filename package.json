{
  "name": "@atomone/atomone-types",
  "version": "4.0.2",
  "description": "JS and TS types relating to Protocol Buffers used by AtomOne",
  "contributors": [
    "Simon Warta <webmaster128@users.noreply.github.com>",
    "Will Clark <willclarktech@users.noreply.github.com>",
    "Dan Lynch <pyramation@gmail.com>",
    "Alex M.<alex.megalokonomos@tendermint.com>"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/atomone-hub/atomone-types"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "cosmos/",
    "cosmos_proto/",
    "gogoproto/",
    "google/",
    "ibc/",
    "atomone/",
    "tendermint/",
    "/binary.*",
    "/helpers.*",
    "/utf8.*",
    "/varint.*",
    "/index.*",
    "/json-safe.*",
    "/registry.*",
    "/types.*",
    "*.md",
    "!cosmos-sdk-*/**/*.md",
    "!atomone-*/**/*.md"
  ],
  "scripts": {
    "format": "prettier --write --loglevel warn \"./src/**/*.ts\" \"./scripts/**/*.js\"",
    "format:check": "prettier --check \"./src/**/*.ts\" \"./scripts/**/*.js\"",
    "codegen": "rm -rf ./src && ./scripts/codegen.js && pnpm run format",
    "prepare-publishing": "./scripts/prepare-publishing.sh",
    "build": "rm -rf ./build && tsc && pnpm run prepare-publishing"
  },
  "packageManager": "pnpm@12.4.2",
  "devDependencies": {
    "@cosmjs/amino": "^0.39.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@cosmjs/tendermint-rpc": "^0.39.0",
    "@cosmology/telescope": "^1.12.21",
    "@types/node": "^26.6.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
